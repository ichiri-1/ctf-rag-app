{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(pwd)",
            "Bash(ls *)",
            "Bash(find *)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Bash(uv sync *)",
            "Bash(uv lock)",
            "Bash(uv run pytest *)",
            "Bash(uv run ruff check *)",
            "Bash(uv run uvicorn *)",
            "Bash(python *)",
            "Bash(uv run python )"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.)",
            "Read(./secrets/**)",
            "Bash(curl *)",
            "Bash(wget *)"
        ]
    }
}
